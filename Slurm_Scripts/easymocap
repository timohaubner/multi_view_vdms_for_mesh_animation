#!/usr/bin/env bash

#SBATCH --job-name=easymocap
#SBATCH --partition=24g
#SBATCH --qos=students_normal
#SBATCH --gres=gpu:1
#SBATCH --nodes=1
#SBATCH --output=slurm-%x-%j.out
#SBATCH --error=slurm-%x-%j.err

set -Eeuo pipefail

###############################################################################
# Konfiguration
###############################################################################

DATA_ROOT="/mnt/home/timohaubner/projects/data/easymocap/Azim30"

HOST_OUTPUT_ROOT="/mnt/home/timohaubner/projects/data/easymocap/output"
CONTAINER_OUTPUT_ROOT="/opt/EasyMocap/output"

CONTAINER_IMAGE="52cde7f3355b"
CONTAINER_ARCHIVE="/mnt/home/timohaubner/easymocap_v3.tar"

###############################################################################
# Alle Sequenzen bestimmen
###############################################################################

mapfile -t SEQUENCES < <(
    find "${DATA_ROOT}" \
        -mindepth 3 \
        -maxdepth 3 \
        -type d \
        -name images \
        -printf '%h\n' |
    sort
)

EXPECTED_SEQUENCES=34

if [[ "${#SEQUENCES[@]}" -ne "${EXPECTED_SEQUENCES}" ]]; then
    echo "FEHLER: ${EXPECTED_SEQUENCES} Sequenzen erwartet, aber"
    echo "        ${#SEQUENCES[@]} Sequenzen gefunden."
    printf 'Gefunden: %s\n' "${SEQUENCES[@]}"
    exit 1
fi

echo "Es wurden ${#SEQUENCES[@]} Sequenzen gefunden."

mkdir -p "${HOST_OUTPUT_ROOT}"

###############################################################################
# GPU überprüfen
###############################################################################

if [[ -z "${CUDA_VISIBLE_DEVICES:-}" ]]; then
    echo "FEHLER: SLURM hat keine GPU über CUDA_VISIBLE_DEVICES zugewiesen."
    exit 1
fi

echo "SLURM-Job:  ${SLURM_JOB_ID}"
echo "Host:       $(hostname)"
echo "CUDA-Gerät: ${CUDA_VISIBLE_DEVICES}"

###############################################################################
# Container-Image bei Bedarf laden
###############################################################################

if ! podman image exists "${CONTAINER_IMAGE}"; then
    echo "Container-Image ${CONTAINER_IMAGE} ist auf $(hostname) nicht vorhanden."
    echo "Lade Image aus ${CONTAINER_ARCHIVE} ..."

    if [[ ! -f "${CONTAINER_ARCHIVE}" ]]; then
        echo "FEHLER: Container-Archiv nicht gefunden:"
        echo "        ${CONTAINER_ARCHIVE}"
        exit 1
    fi

    podman load --input "${CONTAINER_ARCHIVE}"

    if ! podman image exists "${CONTAINER_IMAGE}"; then
        echo "FEHLER: Das Archiv wurde geladen, aber das erwartete Image"
        echo "        ${CONTAINER_IMAGE} wurde nicht gefunden."
        echo
        echo "Im lokalen Podman-Speicher vorhandene Images:"
        podman images --no-trunc
        exit 1
    fi

    echo "Container-Image erfolgreich geladen."
else
    echo "Container-Image ${CONTAINER_IMAGE} ist bereits vorhanden."
fi

###############################################################################
# Aufräumen, falls Job abgebrochen wird
###############################################################################

CURRENT_CONTAINER_NAME=""

cleanup() {
    if [[ -n "${CURRENT_CONTAINER_NAME:-}" ]]; then
        echo "Entferne Container ${CURRENT_CONTAINER_NAME} ..."
        podman rm -f "${CURRENT_CONTAINER_NAME}" >/dev/null 2>&1 || true
    fi
}

trap cleanup EXIT INT TERM

###############################################################################
# Alle Sequenzen nacheinander verarbeiten
###############################################################################

TOTAL_SEQUENCES="${#SEQUENCES[@]}"

for SEQUENCE_INDEX in "${!SEQUENCES[@]}"; do
    SEQ_DIR="${SEQUENCES[$SEQUENCE_INDEX]}"
    SEQ_REL="${SEQ_DIR#"${DATA_ROOT}/"}"

    HOST_SEQ_OUTPUT="${HOST_OUTPUT_ROOT}/${SEQ_REL}"
    CONTAINER_SEQ_OUTPUT="${CONTAINER_OUTPUT_ROOT}/${SEQ_REL}"

    SEQUENCE_NUMBER=$((SEQUENCE_INDEX + 1))

    echo
    echo "================================================================"
    echo "Sequenz ${SEQUENCE_NUMBER}/${TOTAL_SEQUENCES}"
    echo "SLURM-Job:       ${SLURM_JOB_ID}"
    echo "Host:            $(hostname)"
    echo "CUDA-Gerät:      ${CUDA_VISIBLE_DEVICES}"
    echo "Sequenz:         ${SEQ_REL}"
    echo "Eingabe:         ${SEQ_DIR}"
    echo "Kameras:         ${SEQ_DIR}"
    echo "Ausgabe:         ${HOST_SEQ_OUTPUT}"
    echo "================================================================"

    ###########################################################################
    # Kameraparameter der Sequenz überprüfen
    ###########################################################################

    for parameter_file in intri.yml extri.yml; do
        if [[ ! -s "${SEQ_DIR}/${parameter_file}" ]]; then
            echo "FEHLER: Kameraparameter fehlt oder ist leer:"
            echo "        ${SEQ_DIR}/${parameter_file}"
            exit 1
        fi
    done

    ###########################################################################
    # Kameraordner und Bilder überprüfen
    ###########################################################################

    for camera in 00 01 02 03 04; do
        camera_dir="${SEQ_DIR}/images/${camera}"

        if [[ ! -d "${camera_dir}" ]]; then
            echo "FEHLER: Kameraordner fehlt: ${camera_dir}"
            exit 1
        fi

        image_count="$(
            find "${camera_dir}" \
                -maxdepth 1 \
                -type f \
                -name '*.png' |
            wc -l
        )"

        if [[ "${image_count}" -ne 36 ]]; then
            echo "FEHLER: ${camera_dir} enthält ${image_count} PNG-Dateien,"
            echo "        erwartet wurden 36."
            exit 1
        fi
    done

    mkdir -p "${HOST_SEQ_OUTPUT}"

    ###########################################################################
    # Eindeutigen Container-Namen bilden
    ###########################################################################

    SEQ_NAME_SAFE="${SEQ_REL//\//-}"
    CURRENT_CONTAINER_NAME="easymocap-${SLURM_JOB_ID}-${SEQUENCE_INDEX}-${SEQ_NAME_SAFE}"

    ###########################################################################
    # EasyMocap im Container ausführen
    ###########################################################################

    if ! podman run \
        --rm \
        --name "${CURRENT_CONTAINER_NAME}" \
        -v /mnt:/mnt:rw \
        -v /tmp:/tmp:rw \
        -v "${HOST_OUTPUT_ROOT}:${CONTAINER_OUTPUT_ROOT}:rw" \
        -w /opt/EasyMocap \
        --device="nvidia.com/gpu=${CUDA_VISIBLE_DEVICES}" \
        -e "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}" \
        -e "NVIDIA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}" \
        -e PYOPENGL_PLATFORM=egl \
        -e "SEQ_DIR=${SEQ_DIR}" \
        -e "SEQ_REL=${SEQ_REL}" \
        -e "OUTPUT_DIR=${CONTAINER_SEQ_OUTPUT}" \
        --network=host \
        "${CONTAINER_IMAGE}" \
        bash -lc '
            set -Eeuo pipefail

            DATA="${SEQ_DIR}"
            SMPL_DIR="${OUTPUT_DIR}/smpl"
            MESH_DIR="${OUTPUT_DIR}/meshes"
            CFG="config/model/smpl_neutral_custom.yml"

            echo "============================================================"
            echo "EasyMocap-Verzeichnis: $(pwd)"
            echo "Eingabesequenz:        ${DATA}"
            echo "Kameraparameter:       ${DATA}"
            echo "Ausgabeverzeichnis:    ${OUTPUT_DIR}"
            echo "SMPL-Verzeichnis:      ${SMPL_DIR}"
            echo "Mesh-Verzeichnis:      ${MESH_DIR}"
            echo "CUDA_VISIBLE_DEVICES:  ${CUDA_VISIBLE_DEVICES:-nicht gesetzt}"
            echo "============================================================"

            python -c "
import torch

print(\"PyTorch CUDA verfügbar:\", torch.cuda.is_available())
print(\"Sichtbare GPUs:\", torch.cuda.device_count())

if not torch.cuda.is_available():
    raise SystemExit(\"FEHLER: CUDA ist im Container nicht verfügbar\")
"

            mkdir -p "${OUTPUT_DIR}"
            mkdir -p "${MESH_DIR}"

            ###################################################################
            # 1. Keypoints, Triangulation und SMPL-Rekonstruktion
            ###################################################################

            echo
            echo "Starte Keypoint-Erkennung und SMPL-Rekonstruktion ..."

            emc \
                --data config/datasets/mvimage.yml \
                --exp config/mv1p/detect_triangulate_fitSMPL.yml \
                --root "${DATA}" \
                --cameras "${DATA}" \
                --out "${OUTPUT_DIR}" \
                --subs 00 01 02 03 04 \
                --subs_vis 01 02 \
                --ranges 0 36 1 \
                --skip_vis

            ###################################################################
            # SMPL-Ergebnis kontrollieren
            ###################################################################

            if [[ ! -d "${SMPL_DIR}" ]]; then
                echo "FEHLER: EasyMocap hat keinen SMPL-Ordner erzeugt:"
                echo "        ${SMPL_DIR}"
                echo
                echo "Inhalt des Ausgabeverzeichnisses:"
                find "${OUTPUT_DIR}" -maxdepth 3 -print
                exit 1
            fi

            SMPL_COUNT="$(
                find "${SMPL_DIR}" \
                    -type f \
                    -name "*.json" |
                wc -l
            )"

            if [[ "${SMPL_COUNT}" -eq 0 ]]; then
                echo "FEHLER: Keine SMPL-JSON-Dateien gefunden in:"
                echo "        ${SMPL_DIR}"
                find "${OUTPUT_DIR}" -maxdepth 3 -print
                exit 1
            fi

            echo "${SMPL_COUNT} SMPL-JSON-Dateien gefunden."

            ###################################################################
            # 2. OBJ-Mesh-Sequenz erzeugen
            ###################################################################

            echo
            echo "Erzeuge Mesh-Sequenz ..."

            python apps/postprocess/write_vertices.py \
                "${SMPL_DIR}" \
                "${MESH_DIR}" \
                --cfg_model "${CFG}" \
                --mode mesh

            ###################################################################
            # Mesh-Ergebnis kontrollieren
            ###################################################################

            MESH_COUNT="$(
                find "${MESH_DIR}" \
                    -type f \
                    -name "*.obj" |
                wc -l
            )"

            if [[ "${MESH_COUNT}" -eq 0 ]]; then
                echo "FEHLER: Keine OBJ-Meshes erzeugt in:"
                echo "        ${MESH_DIR}"
                exit 1
            fi

            echo
            echo "============================================================"
            echo "Sequenz erfolgreich abgeschlossen: ${SEQ_REL}"
            echo "SMPL-Dateien: ${SMPL_COUNT}"
            echo "OBJ-Meshes:   ${MESH_COUNT}"
            echo "Ausgabe:      ${OUTPUT_DIR}"
            echo "============================================================"
        '
    then
        echo
        echo "FEHLER: Verarbeitung der Sequenz ist fehlgeschlagen:"
        echo "        ${SEQ_REL}"
        exit 1
    fi

    # Der Container wurde durch --rm bereits entfernt.
    CURRENT_CONTAINER_NAME=""

    echo
    echo "Sequenz ${SEQUENCE_NUMBER}/${TOTAL_SEQUENCES} abgeschlossen:"
    echo "${SEQ_REL}"
done

###############################################################################
# Gesamter Job abgeschlossen
###############################################################################

echo
echo "================================================================"
echo "Alle ${TOTAL_SEQUENCES} Sequenzen wurden erfolgreich verarbeitet."
echo "Ergebnisse: ${HOST_OUTPUT_ROOT}"
echo "================================================================"